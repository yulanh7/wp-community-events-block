{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Community Events Hub demo",
		"description": "Lakeside Community: a demo site with events, categories, registrations and the plugin's blocks.",
		"author": "yulanh7",
		"categories": [ "Events" ]
	},
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"login": true,
	"steps": [
		{
			"step": "installTheme",
			"themeData": {
				"resource": "wordpress.org/themes",
				"slug": "twentytwentyfive"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "advanced-custom-fields"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/yulanh7/wp-community-events-block",
				"ref": "playground",
				"refType": "branch"
			},
			"options": {
				"activate": true,
				"targetFolderName": "wp-community-events-block"
			}
		},
		{
			"step": "wp-cli",
			"command": "wp eval-file /wordpress/wp-content/plugins/wp-community-events-block/bin/seed-demo-content.php"
		},
		{
			"step": "wp-cli",
			"command": "wp eval-file /wordpress/wp-content/plugins/wp-community-events-block/playground/setup-site.php"
		}
	]
}
